# Mobile app configuration. Copy to `.env` (git-ignored) and fill in.
# EXPO_PUBLIC_ values are compiled into the app and readable by anyone who has the APK:
# put NO secrets here. The Firebase web config below is designed to be public.

# Backend base URL, without a trailing slash.
#  - Android emulator -> your PC: http://10.0.2.2:3000
#  - Real phone on the same Wi-Fi: http://<your-PC-LAN-IP>:3000
#  - Production: https://api.your-domain.example
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Firebase console -> Project settings -> Your apps -> Web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_APP_ID=
