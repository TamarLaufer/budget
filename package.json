{
  "name": "spendo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@reduxjs/toolkit": "^2.13.0",
    "expo": "~57.0.30",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.28",
    "expo-status-bar": "~57.0.1",
    "firebase": "^13.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "adb reverse tcp:3000 tcp:3000 && adb reverse tcp:8081 tcp:8081 && expo start --dev-client --localhost",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "metro-connect-start": "adb devices && adb reverse tcp:8081 tcp:8081 && npx expo start --dev-client",
    "server:install": "npm --prefix server ci",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "typecheck:frontend": "tsc --noEmit",
    "typecheck:backend": "npm --prefix server run typecheck",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "eslint . --max-warnings=0",
    "lint:backend": "npm --prefix server run lint",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "jest",
    "test:backend": "npm --prefix server test",
    "test:unit": "npm run test:frontend && npm --prefix server run test:unit",
    "test:integration": "npm --prefix server run test:integration",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration"
  },
  "private": true
}
