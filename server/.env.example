# Copy to server/.env and fill in. Never commit .env or service-account files.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL. `npm run db:local` prints these URLs for the embedded dev database.
DATABASE_URL=postgresql://postgres:postgres@localhost:54320/budget_dev
# Used only by the integration tests (optional locally: tests start their own throwaway database).
# Must point to a database whose name contains "test". NEVER point it at production.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:54320/budget_test

# Firebase Authentication (identity only; no app data lives in Firebase).
FIREBASE_PROJECT_ID=your-firebase-project-id
# Revocation checks need Admin credentials. Provide ONE of:
#   - FIREBASE_SERVICE_ACCOUNT_BASE64: base64 of the service-account JSON (handy on PaaS hosts)
#   - GOOGLE_APPLICATION_CREDENTIALS: path to the service-account JSON (outside the repo!)
# Or set FIREBASE_CHECK_REVOKED=false to verify tokens with only the project ID.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\budget-firebase-admin.json
FIREBASE_CHECK_REVOKED=true

# Comma-separated browser origins (only for a future web client). The Android app needs none.
CORS_ORIGINS=
# Set to the number of proxies in front of the API (e.g. 1 behind a load balancer).
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
